# Database (Neon)
DATABASE_URL="postgresql://..."

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Cloudflare R2
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET="orbit-drive"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_REGION="auto"

# Encryption
DRIVE_MASTER_KEY=""  # 32 bytes, hex or base64 encoded

# Public branding bucket (logos/branding) — public-read, SEPARATE from the
# encrypted vault bucket above. Same Cloudflare account, so R2_ENDPOINT is
# reused unless R2_PUBLIC_ENDPOINT is set.
R2_PUBLIC_BUCKET=orbit-drive-public
R2_PUBLIC_BASE_URL=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
