+    def _parse_passthrough_header(
+        self,
+        request: "web.Request",
+        header_name: str,
+    ) -> tuple[Optional[str], Optional["web.Response"]]:
+        """Extract an optional Hermes passthrough header with basic validation."""
+        raw = request.headers.get(header_name, "")
+        if raw is None:
+            return None, None
+        value = raw.strip()
+        if not value:
+            return None, None
+        if re.search(r'[\r\n\x00]', value):
+            return None, web.json_response(
+                {"error": {"message": f"Invalid {header_name}", "type": "invalid_request_error"}},
+                status=400,
+            )
+        if len(value) > self._MAX_SESSION_HEADER_LEN:
+            return None, web.json_response(
+                {"error": {"message": f"{header_name} too long", "type": "invalid_request_error"}},
+                status=400,
+            )
+        return value, None
+
+    def _parse_gateway_tool_headers(
+        self,
+        request: "web.Request",
+    ) -> tuple[dict[str, Optional[str]], Optional["web.Response"]]:
+        """Capture request-scoped Hermes tool context headers.
+
+        Missing values stay ``None`` here and are enforced fail-closed later by
+        the Paperclip tool injector so non-tool turns can still complete.
+        """
+        context: dict[str, Optional[str]] = {}
+        header_map = {
+            "run_id": "X-Hermes-Run-Id",
+            "agent_id": "X-Hermes-Agent-Id",
+            "project_id": "X-Hermes-Project-Id",
+        }
+        for field_name, header_name in header_map.items():
+            value, err = self._parse_passthrough_header(request, header_name)
+            if err is not None:
+                return {}, err
+            context[field_name] = value
+        return context, None
+
