+def _parse_paperclip_session_key(session_key: str) -> tuple[Optional[dict[str, Any]], Optional[str]]:
+    """Decode ``<companyId>:<subAccountId|_business>`` into v1 envelope fields."""
+    raw = str(session_key or "").strip()
+    if not raw:
+        return None, "missing X-Hermes-Session-Key"
+    if raw.count(":") != 1:
+        return None, "invalid X-Hermes-Session-Key format"
+    company_id, scope = raw.split(":", 1)
+    company_id = company_id.strip()
+    scope = scope.strip()
+    if not company_id or not scope:
+        return None, "invalid X-Hermes-Session-Key format"
+    return {
+        "companyId": company_id,
+        "subAccountId": None if scope == "_business" else scope,
+    }, None
+
+
+def _build_paperclip_context_envelope(server_name: str) -> tuple[Optional[dict[str, Any]], Optional[str]]:
+    """Build the reserved Paperclip tenant envelope from request-local context."""
+    from gateway.session_context import get_gateway_request_context, get_session_env
+
+    if not _server_injects_paperclip_context(server_name):
+        return None, None
+
+    session_key = get_session_env("HERMES_SESSION_KEY", "")
+    session_fields, err = _parse_paperclip_session_key(session_key)
+    if err is not None:
+        return None, err
+
+    gateway_ctx = get_gateway_request_context()
+    run_id = str((gateway_ctx or {}).get("run_id") or "").strip()
+    agent_id = str((gateway_ctx or {}).get("agent_id") or "").strip()
+    project_id = str((gateway_ctx or {}).get("project_id") or "").strip()
+    if not run_id:
+        return None, "missing X-Hermes-Run-Id"
+    if not agent_id:
+        return None, "missing X-Hermes-Agent-Id"
+
+    envelope = {
+        **session_fields,
+        "agentId": agent_id,
+        "runId": run_id,
+    }
+    if project_id:
+        envelope["projectId"] = project_id
+    return envelope, None
+
+
+def _inject_paperclip_context_args(server_name: str, args: dict) -> tuple[dict, Optional[str]]:
+    """Overwrite the reserved Paperclip envelope when the server opts in."""
+    if not _server_injects_paperclip_context(server_name):
+        return args, None
+    envelope, err = _build_paperclip_context_envelope(server_name)
+    if err is not None:
+        return {}, err
+    forwarded = dict(args or {})
+    forwarded[_PAPERCLIP_CONTEXT_ARG] = envelope
+    return forwarded, None
+
