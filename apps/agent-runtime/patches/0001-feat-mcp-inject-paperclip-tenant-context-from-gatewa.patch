+def set_gateway_request_context(
+    *,
+    run_id: str = "",
+    agent_id: str = "",
+    project_id: str = "",
+) -> list:
+    """Set request-scoped gateway tool context and return reset tokens."""
+    return [
+        _GATEWAY_RUN_ID.set(run_id),
+        _GATEWAY_AGENT_ID.set(agent_id),
+        _GATEWAY_PROJECT_ID.set(project_id),
+    ]
+
+
+def clear_gateway_request_context(tokens: list) -> None:
+    """Explicitly clear gateway tool context without falling back to env."""
+    for var in (
+        _GATEWAY_RUN_ID,
+        _GATEWAY_AGENT_ID,
+        _GATEWAY_PROJECT_ID,
+    ):
+        var.set("")
+
+
+def get_gateway_request_context() -> dict[str, str]:
+    """Return request-scoped gateway tool context for the current task/thread."""
+    return {
+        "run_id": get_session_env("HERMES_GATEWAY_RUN_ID", ""),
+        "agent_id": get_session_env("HERMES_GATEWAY_AGENT_ID", ""),
+        "project_id": get_session_env("HERMES_GATEWAY_PROJECT_ID", ""),
+    }
+
+
 def get_session_env(name: str, default: str = "") -> str:
     """Read a session context variable by its legacy ``HERMES_SESSION_*`` name.
 
