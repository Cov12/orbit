+    def _seed_mem0_facts_sync(self, *, company_id: str, sub_account_id: Optional[str], facts: List[Any]) -> Dict[str, Any]:
+        """Seed structured facts into the exact mem0_local scope the assistant reads."""
+        scope = _atrium_scope(company_id, sub_account_id)
+        from plugins.memory.mem0_local import Mem0LocalMemoryProvider
+
+        provider = Mem0LocalMemoryProvider()
+        provider.initialize(session_id=f"seed-{uuid.uuid4().hex[:8]}", gateway_session_key=scope)
+        client = provider._get_client()
+        collection = getattr(provider, "_collection", None)
+        agent_id = getattr(provider, "_agent_id", "hermes")
+        filters = {"user_id": scope}
+
+        existing_records = provider._unwrap_results(client.get_all(filters=filters))
+        existing_memories = {str(row.get("memory") or "").strip() for row in existing_records if isinstance(row, dict)}
+        existing_seed_ids = set()
+        for row in existing_records:
+            if not isinstance(row, dict):
+                continue
+            metadata = row.get("metadata") if isinstance(row.get("metadata"), dict) else {}
+            seed_id = metadata.get("seed_id") or row.get("seed_id")
+            if seed_id:
+                existing_seed_ids.add(str(seed_id))
+
+        written: List[Dict[str, Any]] = []
+        skipped: List[Dict[str, Any]] = []
+        for idx, raw_fact in enumerate(facts):
+            memory_text, canonical = _normalize_seed_fact(raw_fact)
+            if not memory_text:
+                skipped.append({"index": idx, "reason": "empty"})
+                continue
+            seed_id = hashlib.sha256(f"{scope}\n{canonical}".encode("utf-8")).hexdigest()
+            if seed_id in existing_seed_ids or memory_text in existing_memories:
+                skipped.append({"index": idx, "seed_id": seed_id, "reason": "already_present"})
+                continue
+            client.add(
+                [{"role": "user", "content": memory_text}],
+                user_id=scope,
+                agent_id=agent_id,
+                metadata={
+                    "source": "engram_seed",
+                    "companyId": company_id,
+                    "subAccountId": sub_account_id,
+                    "scope": scope,
+                    "seed_id": seed_id,
+                    "canonical_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
+                },
+                infer=False,
+            )
+            existing_memories.add(memory_text)
+            existing_seed_ids.add(seed_id)
+            written.append({"index": idx, "seed_id": seed_id, "memory": memory_text})
+
+        readback_records = provider._unwrap_results(client.get_all(filters=filters))
+        readback_memories = [str(row.get("memory") or "") for row in readback_records if isinstance(row, dict) and row.get("memory")]
+        return {
+            "object": "hermes.memory.seed_result",
+            "scope": scope,
+            "companyId": company_id,
+            "subAccountId": sub_account_id,
+            "collection": collection,
+            "written": len(written),
+            "skipped": len(skipped),
+            "written_facts": written,
+            "skipped_facts": skipped,
+            "readback": {
+                "count": len(readback_memories),
+                "matches_written": all(item["memory"] in readback_memories for item in written),
+                "sample": readback_memories[:10],
+            },
+        }
+
+    async def _handle_memory_seed(self, request: "web.Request") -> "web.Response":
+        """POST /v1/memory/seed — direct structured fact seed for Engram."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        body, err = await self._read_json_body(request)
+        if err:
+            return err
+        company_id = str(body.get("companyId") or body.get("company_id") or "").strip()
+        raw_sub = body.get("subAccountId", body.get("sub_account_id"))
+        sub_account_id = str(raw_sub).strip() if raw_sub is not None and str(raw_sub).strip() else None
+        facts = body.get("facts")
+        if not company_id:
+            return web.json_response(_openai_error("Missing required field: companyId", code="missing_company_id"), status=400)
+        if not isinstance(facts, list) or not facts:
+            return web.json_response(_openai_error("facts must be a non-empty array", code="invalid_facts"), status=400)
+        if len(facts) > MAX_MEMORY_SEED_FACTS:
+            return web.json_response(_openai_error(f"facts may contain at most {MAX_MEMORY_SEED_FACTS} items", code="too_many_facts"), status=400)
+        try:
+            result = await asyncio.get_running_loop().run_in_executor(
+                None,
+                lambda: self._seed_mem0_facts_sync(company_id=company_id, sub_account_id=sub_account_id, facts=facts),
+            )
+        except Exception as exc:
+            logger.exception("POST /v1/memory/seed failed")
+            return web.json_response(_openai_error(str(exc), err_type="server_error", code="memory_seed_failed"), status=500)
+        return web.json_response(result)
+
+    def _answers_to_text(self, answers: Any) -> str:
+        if isinstance(answers, str):
+            text = answers
+        else:
+            text = _compact_json(answers)
+        return text[:MAX_ROLE_MAPPING_ANSWER_CHARS]
+
+    def _infer_role_mapping_sync(self, answers_text: str, *, max_roles: int) -> Dict[str, Any]:
+        """Bounded single-shot role mapping using the active profile model."""
+        from run_agent import AIAgent
+        from gateway.run import _resolve_runtime_agent_kwargs, _resolve_gateway_model, GatewayRunner
+
+        system_prompt = (
+            "You map Atrium onboarding interview answers to canonical department roles. "
+            "Return ONLY JSON with shape {\"suggestions\":[{\"role\": string, \"rationale\": string, "
+            "\"first_task_hints\": string[]}]} . Allowed role values: "
+            + ", ".join(sorted(ATRIUM_ROLE_ENUM))
+            + ". Use an empty suggestions array for nonsense, insufficient, or unrelated answers. "
+            "Never invent a role outside the enum. Keep rationales short."
+        )
+        runtime_kwargs = _resolve_runtime_agent_kwargs()
+        reasoning_config = GatewayRunner._load_reasoning_config()
+        agent = AIAgent(
+            model=_resolve_gateway_model(),
+            **runtime_kwargs,
+            max_iterations=1,
+            quiet_mode=True,
+            verbose_logging=False,
+            ephemeral_system_prompt=system_prompt,
+            enabled_toolsets=[],
+            session_id=f"role-map-{uuid.uuid4().hex[:8]}",
+            platform="api_server",
+            skip_memory=True,
+            reasoning_config=reasoning_config,
+        )
+        result = agent.run_conversation(
+            user_message=(
+                "Map these onboarding answers to at most "
+                f"{max_roles} roles. Return JSON only.\n\nAnswers:\n{answers_text}"
+            ),
+            conversation_history=[],
+        )
+        final = result.get("final_response", "") if isinstance(result, dict) else ""
+        parsed = _extract_json_object(final)
+        normalized = _normalize_role_mapping_payload(parsed, max_roles=max_roles)
+        normalized["model"] = self._model_name
+        return normalized
+
+    async def _handle_atrium_role_mapping(self, request: "web.Request") -> "web.Response":
+        """POST /v1/atrium/role-map — bounded structured mapping inference."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        body, err = await self._read_json_body(request)
+        if err:
+            return err
+        answers = body.get("answers")
+        if answers is None:
+            return web.json_response(_openai_error("Missing required field: answers", code="missing_answers"), status=400)
+        try:
+            max_roles = int(body.get("maxRoles") or body.get("max_roles") or 5)
+        except (TypeError, ValueError):
+            max_roles = 5
+        max_roles = max(0, min(max_roles, 12))
+        answers_text = self._answers_to_text(answers)
+        if not answers_text.strip():
+            return web.json_response(_normalize_role_mapping_payload({"suggestions": []}, max_roles=max_roles))
+        try:
+            result = await asyncio.get_running_loop().run_in_executor(
+                None,
+                lambda: self._infer_role_mapping_sync(answers_text, max_roles=max_roles),
+            )
+        except Exception as exc:
+            logger.warning("POST /v1/atrium/role-map inference failed; returning deterministic fallback: %s", exc)
+            result = _deterministic_role_mapping(answers_text, max_roles=max_roles)
+            result["fallback"] = "deterministic"
+            result["model"] = self._model_name
+        return web.json_response(result)
+
