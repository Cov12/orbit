+def _atrium_scope(company_id: str, sub_account_id: Optional[str] = None) -> str:
+    """Return the Orbit memory scope key used by the assistant read path."""
+    company = str(company_id or "").strip()
+    sub = str(sub_account_id or "").strip() or "_business"
+    return f"{company}:{sub}"
+
+
+def _compact_json(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def _normalize_seed_fact(value: Any) -> tuple[str, str]:
+    """Return (memory_text, idempotency_canonical) for a caller-provided fact."""
+    if isinstance(value, str):
+        text = value.strip()
+        canonical = text
+    elif isinstance(value, dict):
+        canonical = _compact_json(value)
+        preferred = value.get("fact") or value.get("memory") or value.get("text") or value.get("content")
+        if preferred is not None and str(preferred).strip():
+            text = str(preferred).strip()
+            extra = {k: v for k, v in value.items() if k not in {"fact", "memory", "text", "content"}}
+            if extra:
+                text = f"{text} | structured={_compact_json(extra)}"
+        else:
+            text = canonical
+    else:
+        canonical = _compact_json(value)
+        text = canonical
+    if len(text) > MAX_MEMORY_SEED_FACT_CHARS:
+        text = text[:MAX_MEMORY_SEED_FACT_CHARS]
+    return text, canonical
+
+
+def _extract_json_object(text: str) -> Dict[str, Any]:
+    """Parse a JSON object from strict or fenced model output."""
+    raw = (text or "").strip()
+    if raw.startswith("```"):
+        raw = re.sub(r"^```(?:json)?\s*", "", raw, flags=re.IGNORECASE)
+        raw = re.sub(r"\s*```$", "", raw)
+    try:
+        data = json.loads(raw)
+    except Exception:
+        start = raw.find("{")
+        end = raw.rfind("}")
+        if start < 0 or end <= start:
+            raise
+        data = json.loads(raw[start : end + 1])
+    if not isinstance(data, dict):
+        raise ValueError("mapping output must be a JSON object")
+    return data
+
+
+def _normalize_role_mapping_payload(data: Dict[str, Any], *, max_roles: int = 5) -> Dict[str, Any]:
+    """Validate role-map JSON, dropping hallucinated roles and non-string hints."""
+    raw_suggestions = data.get("suggestions")
+    if raw_suggestions is None and isinstance(data.get("roles"), list):
+        raw_suggestions = [{"role": role, "rationale": data.get("rationale", "")} for role in data.get("roles", [])]
+    if not isinstance(raw_suggestions, list):
+        raw_suggestions = []
+
+    suggestions: List[Dict[str, Any]] = []
+    seen: set[str] = set()
+    for item in raw_suggestions:
+        if isinstance(item, str):
+            role = item.strip().lower()
+            rationale = ""
+            hints: List[str] = []
+        elif isinstance(item, dict):
+            role = str(item.get("role") or "").strip().lower()
+            rationale = str(item.get("rationale") or "").strip()[:500]
+            raw_hints = item.get("first_task_hints") or item.get("firstTaskHints") or []
+            hints = [str(h).strip()[:200] for h in raw_hints if str(h).strip()] if isinstance(raw_hints, list) else []
+        else:
+            continue
+        if role not in ATRIUM_ROLE_ENUM or role in seen:
+            continue
+        seen.add(role)
+        suggestions.append({
+            "role": role,
+            "rationale": rationale,
+            "first_task_hints": hints[:5],
+        })
+        if len(suggestions) >= max_roles:
+            break
+    return {
+        "object": "hermes.atrium.role_mapping",
+        "roles": [s["role"] for s in suggestions],
+        "suggestions": suggestions,
+    }
+
+
+def _deterministic_role_mapping(answers_text: str, *, max_roles: int = 5) -> Dict[str, Any]:
+    """Small safety net for tests/LLM failures; Conductor owns the formal fallback."""
+    text = (answers_text or "").lower()
+    keyword_map = [
+        ("cto", ("technical", "architecture", "engineering strategy", "stack", "codebase", "integrations")),
+        ("engineer", ("build", "feature", "bug", "frontend", "backend", "api", "code")),
+        ("devops", ("deploy", "deployment", "infra", "hosting", "ci", "cd", "server", "uptime")),
+        ("security", ("security", "compliance", "permission", "auth", "risk", "audit")),
+        ("cmo", ("marketing", "campaign", "brand", "social", "ads", "leads", "audience")),
+        ("sales", ("sales", "prospect", "qualification", "qualify", "conversion", "closing", "crm hygiene")),
+        ("support", ("support", "ticket", "tickets", "customer success", "onboarding", "retention", "churn", "renewal")),
+        ("content", ("content", "editorial", "blog", "copywriting", "copy", "newsletter", "publishing calendar")),
+        ("cfo", ("finance", "budget", "billing", "invoice", "cash", "revenue")),
+        ("designer", ("design", "visual", "logo", "ux", "ui", "brand kit")),
+        ("pm", ("roadmap", "project", "timeline", "requirements", "coordinate")),
+        ("qa", ("test", "quality", "bug bash", "regression", "acceptance")),
+        ("researcher", ("research", "market", "competitor", "analyze", "discovery")),
+    ]
+    suggestions = []
+    for role, words in keyword_map:
+        hits = [w for w in words if w in text]
+        if hits:
+            suggestions.append({
+                "role": role,
+                "rationale": f"Matched onboarding language around {', '.join(hits[:3])}.",
+                "first_task_hints": [],
+            })
+        if len(suggestions) >= max_roles:
+            break
+    return {"object": "hermes.atrium.role_mapping", "roles": [s["role"] for s in suggestions], "suggestions": suggestions}
+
