# ================================
# WORKPIPE ENVIRONMENT CONFIGURATION
# ================================
# Copy this file to .env.local and fill in your values

# ================================
# AUTHENTICATION (Clerk)
# ================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/business/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/business/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/business
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/business

# ================================
# DATABASE
# ================================
# Primary database connection
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Environment-specific database URLs (optional)
PROD_DATABASE_URL="postgresql://username:password@prod-host:port/database?sslmode=require"
LOCAL_DATABASE_URL="postgresql://username:password@localhost:port/database"

# Legacy database credentials (if needed)
DB_USERNAME="username"
DB_PASSWORD="password"
DATABPASE_PASSWORD=

# ================================
# APPLICATION CONFIGURATION
# ================================
NEXT_PUBLIC_URL=http://localhost:3000/
NEXT_PUBLIC_DOMAIN=localhost:3000
NEXT_PUBLIC_SCHEME=http://

# ================================
# FILE UPLOAD (UploadThing)
# ================================
UPLOADTHING_SECRET=sk_live_your_secret_here
UPLOADTHING_APP_ID=your_app_id_here

# ================================
# PAYMENT PROCESSING (Stripe)
# ================================
# Stripe API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Connect Configuration
NEXT_PUBLIC_STRIPE_CLIENT_ID=ca_your_client_id_here

# Platform Fee Configuration
NEXT_PUBLIC_PLATFORM_SUBSCRIPTION_PERCENT=0
NEXT_PUBLIC_PLATFORM_ONETIME_FEE=0
NEXT_PUBLIC_PLATFORM_BUSINESS_PERCENT=0

# Stripe Product IDs
NEXT_WORKPIPE_PRODUCT_ID=prod_your_product_id_here

# ================================
# THIRD-PARTY INTEGRATIONS
# ================================
# Builder.io (if using)
NEXT_PUBLIC_BUILDER_API_KEY=your_builder_api_key_here

# ================================
# DEVELOPMENT & DEBUGGING
# ================================
# Uncomment for development debugging
# NEXT_PUBLIC_DEBUG=true
# NODE_ENV=development
# Orbit Portal URL (centralized auth)
NEXT_PUBLIC_PORTAL_URL=https://portal.orbit.example
