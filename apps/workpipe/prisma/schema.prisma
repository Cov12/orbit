datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUSINESS_OWNER
  BUSINESS_ADMIN
  BUSINESS_GUEST//cleanup: may not be needed
  SUBACCOUNT_OWNER
  SUBACCOUNT_USER
  SUBACCOUNT_GUEST
}

enum Icon {
  settings
  chart
  calendar
  check
  chip
  compass
  database
  flag
  home
  info
  link
  lock
  messages
  notification
  payment
  power
  receipt
  shield
  star
  tune
  videorecorder
  wallet
  warning
  headphone
  send
  pipelines
  person
  category
  contact
  clipboardIcon
}

model User {
  id           String         @id @default(uuid())
  name         String
  avatarUrl    String         @db.Text
  email        String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  role         Role           @default(SUBACCOUNT_USER)
  businessId     String?
  Business       Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  Permissions  Permissions[]
  Ticket       Ticket[]
  Notification Notification[]

  @@index([businessId])
}

model Permissions {
  id           String     @id @default(uuid())
  email        String
  User         User       @relation(fields: [email], references: [email], onDelete: Cascade)
  subAccountId String
  SubAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  access       Boolean

  @@index([subAccountId])
  @@index([email])
}

model Business {
  id               String                @id @default(uuid())
  connectAccountId String?               @default("")
  customerId       String?               @default("")//customer subscribed to platform, not subaccount — made optional so businesses can onboard without Stripe
  name             String
  businessLogo     String                @db.Text
  companyEmail     String                @db.Text
  companyPhone     String
  whiteLabel       Boolean               @default(true)
  address          String
  city             String
  zipCode          String
  state            String
  country          String
  goal             Int                   @default(5)
  users            User[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  SubAccount       SubAccount[]
  SidebarOption    BusinessSidebarOption[]
  Invitation       Invitation[]
  Notification     Notification[]
  Subscription     Subscription?
  AddOns           AddOns[]
}

model SubAccount {
  id               String                    @id @default(uuid())
  connectAccountId String?                   @default("")
  name             String
  subAccountLogo   String                    @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  companyEmail     String                    @db.Text
  companyPhone     String
  goal             Int                       @default(5)
  address          String
  city             String
  zipCode          String
  state            String
  country          String
  businessId       String
  SidebarOption    SubAccountSidebarOption[]
  Permissions      Permissions[]
  Funnels          Funnel[]
  Profiles         Profile[]
  Media            Media[]
  Contact          Contact[]
  ContactSubmission ContactSubmission[]
  Trigger          Trigger[]
  Automation       Automation[]
  Pipeline         Pipeline[]
  Tags             Tag[]
  Notification     Notification[]
  Services         Service[]
  Documents        Document[]
  Invoices         Invoice[]
  Payments         Payment[]
  CalendarEvent    CalendarEvent[]

  Business         Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Tag {
  id           String   @id @default(uuid())
  name         String
  color        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subAccountId String

  SubAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  Ticket     Ticket[]
  Contact    Contact[]

  @@index([subAccountId])
}

model Service {
  id           String   @id @default(uuid())
  name         String
  color        String
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subAccountId String

  SubAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([subAccountId])
}

model Pipeline {
  id           String     @id @default(uuid())
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Lane         Lane[]
  SubAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  subAccountId String

  @@index([subAccountId])
}

model Lane {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String
  Tickets    Ticket[]
  order      Int      @default(0)

  @@index([pipelineId])
}

model Ticket {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  laneId      String
  order       Int      @default(0)
  Lane        Lane     @relation(fields: [laneId], references: [id], onDelete: Cascade)
  value       Decimal?
  description String?
  Tags        Tag[]

  customerId String?
  Customer   Contact? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  assignedUserId String?
  Assigned       User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  CalendarEvent  CalendarEvent[]

  @@index([laneId])
  @@index([customerId])
  @@index([assignedUserId])
}

enum TriggerTypes {
  CONTACT_FORM
}

model Trigger {
  id           String       @id @default(uuid())
  name         String
  type         TriggerTypes
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  subAccountId String
  Subaccount   SubAccount   @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  Automations  Automation[]

  @@index([subAccountId])
}

model Automation {
  id                 String               @id @default(uuid())
  name               String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  triggerId          String?
  published          Boolean              @default(false)
  Trigger            Trigger?             @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  subAccountId       String
  Subaccount         SubAccount           @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  Action             Action[]
  AutomationInstance AutomationInstance[]

  @@index([triggerId])
  @@index([subAccountId])
}

model AutomationInstance {
  id           String     @id @default(uuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  automationId String
  Automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  active       Boolean    @default(false)

  @@index([automationId])
}

enum ActionType {
  CREATE_CONTACT
}

model Action {
  id           String     @id @default(uuid())
  name         String
  type         ActionType
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  automationId String
  order        Int
  Automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  laneId       String     @default("0")

  @@index([automationId])
}

model Contact {
  id           String   @id @default(uuid())
  name         String
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subAccountId String

  // Identity (additive, nullable)
  firstName   String?
  lastName    String?
  phone       String?
  companyName String?

  // Address / locale
  address1   String?
  address2   String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  timezone   String?
  website    String?

  // CRM / ownership (loose strings for now; formalize later)
  assignedUserId String?
  status         String?
  source         String?
  sourceType     String?

  // Current attribution snapshot
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrerUrl    String?
  landingPageUrl String?
  sourceFormId   String?
  sourceFormName String?

  // Activity / operational context
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  lastSubmittedAt DateTime?
  ipAddress       String?
  userAgent       String?

  // Flexible extension
  customFields Json?

  Subaccount    SubAccount          @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  Ticket        Ticket[]
  CalendarEvent CalendarEvent[]
  Submissions   ContactSubmission[]
  Tags          Tag[]

  @@index([subAccountId])
}


model Media {
  id           String     @id @default(uuid())
  type         String?
  name         String
  link         String     @unique
  subAccountId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Subaccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([subAccountId])
}

model Document {
  id           String     @id @default(uuid())
  type         String?
  name         String
  link         String     @unique
  size         String
  subAccountId String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Subaccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([subAccountId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id              String           @id @default(uuid())
  number          String?
  status          InvoiceStatus    @default(DRAFT)
  type            String?
  name            String
  dueDate         DateTime?
  currency        String           @default("usd")
  // Amounts stored as integer cents (consistent with the Payment ledger) —
  // no float/decimal-string drift. Server always computes these from services.
  subTotalCents   Int              @default(0)
  taxCents        Int              @default(0)
  discountCents   Int              @default(0)
  totalDueCents   Int              @default(0)
  netPaymentTerm  String?
  // Public pay/view token — assigned when the invoice is sent (nullable so
  // drafts don't collide on the unique constraint).
  link            String?          @unique
  paidAt          DateTime?
  subAccountId    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  services        InvoiceService[]
  Subaccount      SubAccount       @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([subAccountId])
  @@index([status])
}

model InvoiceService {
  id             String   @id @default(uuid())
  type           String?
  name           String
  description    String?
  quantity       Int      @default(1)
  unitPriceCents Int      @default(0)
  totalCents     Int      @default(0)
  invoiceId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentSource {
  FUNNEL
  INVOICE
}

// Unified revenue ledger. Every completed Stripe Connect payment — funnel
// checkout or invoice pay-link — records exactly one Payment row. Amounts are
// captured from Stripe (never the client) in the smallest currency unit.
// `source` disambiguates origin; funnelId/invoiceId link back to the source.
model Payment {
  id                    String        @id @default(uuid())
  amountCents           Int
  currency              String        @default("usd")
  source                PaymentSource
  status                String        @default("PAID")
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  funnelId              String?
  invoiceId             String?
  customerEmail         String?
  subAccountId          String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  Subaccount            SubAccount    @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([subAccountId])
  @@index([funnelId])
  @@index([invoiceId])
}

model Funnel {
  id            String       @id @default(uuid())
  name          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  description   String?
  published     Boolean      @default(false)
  subDomainName String?      @unique
  favicon       String?      @db.Text
  subAccountId  String
  SubAccount    SubAccount   @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  FunnelPages   FunnelPage[]
  liveProducts  String?      @default("[]")
  ClassName     FunnelClassName[]

  @@index([subAccountId])
}

model Profile {
  id            String       @id @default(uuid())
  name          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  description   String?
  published     Boolean      @default(false)
  subDomainName String?      @unique
  favicon       String?      @db.Text
  subAccountId  String
  SubAccount    SubAccount   @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  ProfilePages  ProfilePage[]
  liveProducts  String?      @default("[]")
  ClassName     ProfileClassName[]

  @@index([subAccountId])
}

model FunnelClassName {
  id         String   @id @default(uuid())
  name       String
  color      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  funnelId   String
  customData String?  @db.Text
  Funnel     Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId])
}

model ProfileClassName {
  id         String   @id @default(uuid())
  name       String
  color      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profileId  String
  customData String?  @db.Text
  Profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model FunnelPage {
  id           String   @id @default(uuid())
  name         String
  pathName     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visits       Int      @default(0)
  content      String?  @db.Text
  order        Int
  previewImage String?  @db.Text
  funnelId     String
  Funnel       Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId])
}

model ProfilePage {
  id           String   @id @default(uuid())
  name         String
  pathName     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visits       Int      @default(0)
  content      String?  @db.Text
  order        Int
  previewImage String?  @db.Text
  profileId     String
  Profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model BusinessSidebarOption {
  id        String   @id @default(uuid())
  name      String   @default("Menu")
  link      String   @default("#")
  icon      Icon     @default(info)
  businessId  String
  Business    Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model SubAccountSidebarOption {
  id           String      @id @default(uuid())
  name         String      @default("Menu")
  link         String      @default("#")
  icon         Icon        @default(info)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  SubAccount   SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  subAccountId String?

  @@index([subAccountId])
}

enum InvitationStatus {
  ACCEPTED
  REVOKED
  PENDING
}

model Invitation {
  id       String           @id @default(uuid())
  email    String           @unique
  businessId String
  Business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status   InvitationStatus @default(PENDING)
  role     Role             @default(SUBACCOUNT_USER)

  @@index([businessId])
}

model Notification {
  id           String  @id @default(uuid())
  notification String
  businessId   String
  subAccountId String?
  userId       String

  User       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  SubAccount SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([subAccountId])
  @@index([userId])
}

enum Plan {
  price_REDACTED
  price_REDACTED
  price_REDACTED
  price_REDACTED
  price_REDACTED
}

model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plan?
  price     String?
  active    Boolean  @default(false)

  priceId              String
  customerId           String
  currentPeriodEndDate DateTime
  subscritiptionId     String   @unique

  businessId String? @unique
  Business   Business? @relation(fields: [businessId], references: [id])

  @@index([customerId])
}

model AddOns {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  active    Boolean  @default(false)
  priceId   String   @unique
  businessId  String?
  Business    Business?  @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model CalendarEvent {
  id             String    @id @default(uuid())
  title          String
  description    String?
  start          DateTime
  end            DateTime?
  allDay         Boolean   @default(false)
  color          String?

  subAccountId   String
  createdById    String?

  contactId      String?
  ticketId       String?

  category       String?

  provider       String?
  externalId     String?
  syncStatus     String?
  lastSyncedAt   DateTime?

  recurrenceRule String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  SubAccount     SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  Contact        Contact?   @relation(fields: [contactId], references: [id])
  Ticket         Ticket?    @relation(fields: [ticketId], references: [id])

  @@index([subAccountId])
  @@index([contactId])
  @@index([start, end])
  @@index([externalId, provider])
}

model ContactSubmission {
  id             String   @id @default(uuid())
  contactId      String
  subAccountId   String
  formId         String?
  formName       String?
  submissionType String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrerUrl    String?
  landingPageUrl String?
  ipAddress      String?
  userAgent      String?
  rawPayload     Json?
  isFirstTouch   Boolean  @default(false)
  isLastTouch    Boolean  @default(false)
  createdAt      DateTime @default(now())

  Contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  SubAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([subAccountId])
}
