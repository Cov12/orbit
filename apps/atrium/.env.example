# Copy this file to .env and adjust values as needed for local development.

# Required by atrium service. Example points to local postgres container.
DATABASE_URL=postgresql://atrium:atrium_dev@postgres:5432/atrium

# Shared JWT secret with Orbit Portal — must match the JWT_SECRET in portal.orbit.example.
# Used to validate portal-issued JWTs during cross-app authentication.
JWT_SECRET=dev-secret-change-me

# WorkPipe backend API URL (host machine default for local integration).
WORKPIPE_API_URL=http://host.docker.internal:3000

# Secret key for Web UI integration.
WEBUI_SECRET_KEY=dev-secret

# Canonical public origin of THIS Atrium deployment, scheme + host, no trailing slash.
# Surfaced to the frontend on GET /api/atrium/orgs/{org_id}/subaccounts as `publicOrigin`
# so the "create your first sub-account" CTA can build a Portal returnTo that matches
# Portal's redirect allowlist EXACTLY. window.location.origin is not a safe substitute —
# behind a proxy / preview host / custom domain it can differ from the registered origin
# and the return hop then fails the allowlist. Unset -> the frontend falls back to
# window.location.origin.
ATRIUM_PUBLIC_ORIGIN=https://atrium.orbit.example

# Dev/test only — allow X-Org-Id header fallback to satisfy require_app_access checks.
# DO NOT SET IN PRODUCTION. Production must rely on Portal JWTs only.
# ATRIUM_DEV_ALLOW_HEADER_AUTH=1

# --- Orbit Conductor bridge (thin-transport chat) -------------------------------
# When enabled, Atrium forwards every chat turn to the Conductor Orbit Assistant
# (block-and-return) instead of the legacy local lane/intent/model routing.
# Leave disabled to keep the legacy path.
ORBIT_BRIDGE_ENABLED=false
# Conductor Orbit bridge plugin endpoint (block-and-return /chat).
CONDUCTOR_BRIDGE_URL=https://conductor.orbit.example/api/plugins/00000000-0000-4000-a000-00000000b003/api/chat
# Shared secret for the bridge (x-orbit-bridge-secret header). Set in prod env only.
ORBIT_BRIDGE_SECRET=
# The single Orbit Assistant agent the bridge routes to.
ORBIT_AGENT_ID=00000000-0000-4000-a000-0000000a9e01
# v1: a single configured Conductor company. Per-org resolution is blocked on #60.
ORBIT_COMPANY_ID=
# Client timeout (s); the bridge blocks up to 120s, so keep this above that.
CONDUCTOR_BRIDGE_TIMEOUT_S=125
