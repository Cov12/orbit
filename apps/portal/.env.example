# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orbit_portal

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# JWT (for cross-app auth tokens)
JWT_SECRET=change-me-to-a-random-64-char-string

# R2 — public Orbit branding bucket (workspace logos captured at onboarding).
# Public-read bucket, separate from Orbit Drive's encrypted vault. Managed by
# Drive in the branding sweep (Orbit-drive#4).
R2_ENDPOINT=                 # S3 API endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orbit-branding
R2_PUBLIC_BASE_URL=          # public base, e.g. https://pub-<hash>.r2.dev or https://branding.orbit.example

# App URLs
NEXT_PUBLIC_WORKPIPE_URL=https://workpipe.orbit.example
NEXT_PUBLIC_ATRIUM_URL=https://atrium.orbit.example
NEXT_PUBLIC_PORTAL_URL=https://portal.orbit.example
# Consumed in PR #2 (Portal UI for Conductor)
NEXT_PUBLIC_CONDUCTOR_URL=

# Conductor feature flags (CSV of org IDs or slugs — matched id-first, slug-fallback)
PORTAL_CONDUCTOR_VISIBLE_ORGS=
PORTAL_CONDUCTOR_LAUNCH_ENABLED_ORGS=
